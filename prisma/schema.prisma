generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurante {
  id        String   @id @default(uuid())
  nome      String
  cnpj      String   @unique
  endereco  String
  createdAt DateTime @default(now())
  
  administradores Administrador[]
  garcons         Garcom[]
  mesas           Mesa[]
  itens           Item[]

  @@map("restaurantes")
}

model Administrador {
  id             String      @id @default(uuid())
  nome           String
  email          String      @unique
  passwordHash   String
  restauranteId  String
  restaurante    Restaurante @relation(fields: [restauranteId], references: [id])
  role           String      @default("ADMIN")

  @@map("administradores")
}

model Garcom {
  id             String      @id @default(uuid())
  nome           String
  email          String      @unique
  passwordHash   String
  restauranteId  String
  restaurante    Restaurante @relation(fields: [restauranteId], references: [id])
  pedidos        Pedido[]
  role           String      @default("WAITER")

  @@map("garcons")
}

model Mesa {
  id             String      @id @default(uuid())
  numero         Int
  capacidade     Int
  restauranteId  String
  restaurante    Restaurante @relation(fields: [restauranteId], references: [id])
  pedidos        Pedido[]

  @@map("mesas")
}

model Item {
  id             String       @id @default(uuid())
  nome           String
  descricao      String?
  preco          Float
  restauranteId  String
  restaurante    Restaurante  @relation(fields: [restauranteId], references: [id])
  itensPedido    ItemPedido[]

  @@map("itens")
}

model Pedido {
  id           String       @id @default(uuid())
  status       String       @default("ABERTO") // ABERTO, FECHADO, CANCELADO
  mesaId       String
  mesa         Mesa         @relation(fields: [mesaId], references: [id])
  garcomId     String
  garcom       Garcom       @relation(fields: [garcomId], references: [id])
  itens        ItemPedido[]
  createdAt    DateTime     @default(now())

  @@map("pedidos")
}

model ItemPedido {
  id           String @id @default(uuid())
  pedidoId     String
  pedido       Pedido @relation(fields: [pedidoId], references: [id])
  itemId       String
  item         Item   @relation(fields: [itemId], references: [id])
  quantidade   Int    @default(1)

  @@map("itens_pedido")
}
